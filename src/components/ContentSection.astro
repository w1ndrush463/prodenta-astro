---
interface Props {
  title: string;
  content: string[];
  image: string;
  imageAlt: string;
  imagePosition?: 'left' | 'right';
  bgColor?: string;
}

const { title, content, image, imageAlt, imagePosition = 'left', bgColor = '' } = Astro.props;

const isLeft = imagePosition === 'left';
---

<section class={`section-padding ${bgColor}`}>
  <div class={`max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center ${!isLeft ? 'lg:[&>*:first-child]:order-2' : ''}`}>
    <div>
      <img src={image} alt={imageAlt} class="rounded-2xl shadow-soft w-full object-cover aspect-[4/3]" loading="lazy">
    </div>
    <div>
      <h2 class="text-section font-display font-bold uppercase tracking-wider text-primary mb-6">{title}</h2>
      {content.map((p) => (
        <p class="text-text-primary leading-relaxed mb-4" set:html={p} />
      ))}
      <slot />
    </div>
  </div>
</section>
