---
interface Props {
  name: string;
  role: string;
  image: string;
  bio: string[];
  expertise?: string[];
  profileHref?: string;
}

const { name, role, image, bio, expertise, profileHref } = Astro.props;
const cardId = name.toLowerCase().replace(/[^a-z]+/g, '-');
---

<div class="bg-white rounded-xl shadow-soft overflow-hidden team-member-card">
  <div class="flex flex-col sm:flex-row gap-6 p-6">
    <div class="shrink-0">
      <img src={image} alt={name} class="w-32 h-32 rounded-xl object-cover" loading="lazy">
    </div>
    <div class="flex-1">
      <h3 class="font-display font-bold uppercase tracking-wider text-primary text-lg">{name}</h3>
      <p class="text-accent font-semibold text-sm mb-3">{role}</p>
      <p class="text-text-secondary text-sm leading-relaxed line-clamp-3">{bio[0]}</p>
      <button
        class="text-primary font-semibold text-sm mt-3 hover:text-secondary transition-colors cursor-pointer"
        onclick={`document.getElementById('${cardId}').classList.toggle('expanded')`}
      >
        Read more &darr;
      </button>
    </div>
  </div>
  <div id={cardId} class="team-expandable">
    <div class="px-6 pb-6 space-y-3">
      {bio.slice(1).map((p) => (
        <p class="text-text-secondary text-sm leading-relaxed">{p}</p>
      ))}
      {expertise && expertise.length > 0 && (
        <div class="mt-4">
          <h4 class="font-display font-semibold uppercase tracking-wider text-xs text-primary mb-2">Areas of Expertise</h4>
          <div class="flex flex-wrap gap-2">
            {expertise.map((e) => (
              <span class="bg-bg-blue text-primary text-xs px-3 py-1 rounded-full font-medium">{e}</span>
            ))}
          </div>
        </div>
      )}
      {profileHref && (
        <a href={profileHref} class="inline-block text-primary font-semibold text-sm mt-3 hover:text-secondary transition-colors">
          View full profile &rarr;
        </a>
      )}
    </div>
  </div>
</div>

<style>
  .team-expandable {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }
  .team-member-card .expanded {
    max-height: 1000px;
  }
</style>
