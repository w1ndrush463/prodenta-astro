---
interface Props {
  heading?: string;
  faqs: { question: string; answer: string }[];
}
const { heading = 'Common questions', faqs } = Astro.props;
---

{faqs.length > 0 && (
  <section class="section">
    <div class="wrap wrap-narrow">
      <h2 class="text-title">{heading}</h2>
      <div class="mt-8 border-t border-line">
        {faqs.map((f) => (
          <details class="group border-b border-line">
            <summary class="flex items-start justify-between gap-6 py-5">
              <h3 class="font-sans text-lg font-semibold">{f.question}</h3>
              <span class="relative mt-1.5 h-4 w-4 shrink-0 text-ink" aria-hidden="true">
                <span class="absolute left-0 top-1/2 h-[1.5px] w-4 bg-current"></span>
                <span class="absolute left-1/2 top-0 h-4 w-[1.5px] bg-current transition-transform group-open:rotate-90"></span>
              </span>
            </summary>
            <p class="max-w-2xl pb-6">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
