---
interface Props {
  heading?: string;
  faqs: { question: string; answer: string }[];
}
const { heading = 'Questions, answered', faqs } = Astro.props;
---

{faqs.length > 0 && (
  <section class="section">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4" data-reveal>
        <p class="eyebrow mb-5">FAQs</p>
        <h2 class="text-title">{heading}</h2>
      </div>
      <div class="border-t border-ink/80 lg:col-span-8">
        {faqs.map((f) => (
          <details class="group border-b border-line">
            <summary class="flex items-start justify-between gap-6 py-6">
              <h3 class="font-display text-[1.6rem] leading-tight">{f.question}</h3>
              <span class="relative mt-2 h-4 w-4 shrink-0 text-ink" aria-hidden="true">
                <span class="absolute left-0 top-1/2 h-px w-4 bg-current"></span>
                <span class="absolute left-1/2 top-0 h-4 w-px bg-current transition-transform group-open:rotate-90"></span>
              </span>
            </summary>
            <p class="max-w-2xl pb-7">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
