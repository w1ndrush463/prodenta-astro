---
// Team photo, or a quiet monogram when no photo has been uploaded yet.
import Img from './Img.astro';
import { resolveImage } from '../lib/images';

interface Props {
  photo?: string;
  name: string;
  class?: string;
  sizes?: string;
  priority?: boolean;
}
const { photo, name, class: className = 'aspect-[4/5]', sizes = '(min-width: 1024px) 25vw, 50vw', priority = false } = Astro.props;
const has = Boolean(resolveImage(photo));
const initials = name.replace(/^Dr\.?\s+/i, '').split(/[\s-]+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---

{has ? (
  <Img src={photo} alt={name} class={`shape-soft ${className}`} sizes={sizes} width={600} position="center 20%" priority={priority} />
) : (
  <div class:list={['shape-soft flex items-center justify-center bg-mist', className]} role="img" aria-label={name}>
    <span class="font-display text-5xl text-teal" aria-hidden="true">{initials}</span>
  </div>
)}
