---
// Address, hours and a click-to-load map (the Google iframe only loads on request).
import { site as getSite, telHref } from '../lib/content';

interface Props {
  heading?: string;
  showTravel?: boolean;
}
const { heading = 'Find us in Battersea', showTravel = false } = Astro.props;
const site = await getSite();
const hours: { days: string; times: string }[] = site.hours ?? [];
const travel: { title: string; text: string }[] = site.gettingHere ?? [];
---

<section class="section border-t border-line">
  <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 class="text-title">{heading}</h2>

      <div class="mt-10 grid gap-8 sm:grid-cols-2">
        <div>
          <h3 class="label mb-3">Address</h3>
          <address class="not-italic">
            {site.address?.line1}<br />
            {site.address?.area}, {site.address?.city}<br />
            {site.address?.postcode}
          </address>
          <p class="mt-3"><a href={telHref(site.phone)} class="font-semibold text-ink">{site.phone}</a></p>
        </div>
        <div>
          <h3 class="label mb-3">Opening hours</h3>
          <dl class="space-y-2">
            {hours.map((h) => (
              <div>
                <dt class="text-ink">{h.days}</dt>
                <dd class="text-muted">{h.times}</dd>
              </div>
            ))}
          </dl>
          {site.hoursNote && <p class="mt-3 text-sm text-muted">{site.hoursNote}</p>}
        </div>
      </div>

      {showTravel && travel.length > 0 && (
        <dl class="mt-10 space-y-4 border-t border-line pt-8">
          {travel.map((t) => (
            <div class="grid grid-cols-[6.5rem_1fr] gap-4">
              <dt class="label pt-1">{t.title}</dt>
              <dd>{t.text}</dd>
            </div>
          ))}
        </dl>
      )}

      <p class="mt-10"><a href={site.directionsUrl} target="_blank" rel="noopener" class="link">Get directions </a></p>
    </div>

    <div class="lg:col-span-7">
      <div class="relative flex aspect-[4/3] items-center justify-center overflow-hidden shape-soft bg-mist lg:aspect-auto lg:h-full lg:min-h-[30rem]" data-map={site.mapEmbedUrl}>
        <svg class="absolute inset-0 h-full w-full text-ink/[0.07]" aria-hidden="true">
          <defs><pattern id="map-grid" width="64" height="64" patternUnits="userSpaceOnUse" patternTransform="rotate(18)"><path d="M0 32h64M32 0v64" stroke="currentColor" stroke-width="10" /><path d="M0 0h64M0 0v64" stroke="currentColor" stroke-width="2" /></pattern></defs>
          <rect width="100%" height="100%" fill="url(#map-grid)" />
        </svg>
        <div class="relative px-6 text-center">
          <svg viewBox="0 0 24 24" class="mx-auto h-9 w-9 text-ink" fill="none" stroke="currentColor" stroke-width="1.1" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.500C5 14.800 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          <p class="mt-3 font-display text-2xl text-ink">{site.address?.line1}</p>
          <p class="text-muted">{site.address?.area}, {site.address?.postcode}</p>
          <button type="button" class="btn btn-outline mt-6" data-map-load>View map</button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-map]')) {
    box.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = box.dataset.map!;
      frame.title = 'Map showing the practice location';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      frame.className = 'absolute inset-0 h-full w-full border-0';
      box.replaceChildren(frame);
      frame.focus();
    });
  }
</script>
