---
// Closing call-to-action panel. Text comes from Site settings > Booking banner.
import Img from './Img.astro';
import { site as getSite, telHref } from '../lib/content';

const site = await getSite();
const b = site.booking ?? {};
---

<section class="pb-[var(--spacing-section)]">
  <div class="wrap">
    <div class="shape-soft grid overflow-hidden bg-mist md:grid-cols-5">
      <div class="p-8 sm:p-12 md:col-span-3 lg:p-16">
        <h2 class="text-title">{b.heading}</h2>
        <p class="mt-4 max-w-md">{b.text}</p>
        <div class="mt-8 flex flex-wrap items-center gap-x-7 gap-y-4">
          <a href="/contact" class="btn">{b.buttonLabel || 'Book an appointment'}</a>
          <a href={telHref(site.phone)} class="link">Call {site.phone}</a>
        </div>
      </div>
      <div class="relative md:col-span-2"><Img src={b.image} alt={b.imageAlt} class="aspect-[4/3] md:absolute md:inset-0 md:aspect-auto" sizes="(min-width: 768px) 40vw, 92vw" width={560} position="center 25%" /></div>
    </div>
  </div>
</section>
