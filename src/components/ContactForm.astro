---
interface Props {
  formType?: 'appointment' | 'consultation' | 'both';
}

const { formType = 'both' } = Astro.props;
const showBoth = formType === 'both';
---

{showBoth && (
  <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mb-8">
    <button
      class="form-tab active px-4 sm:px-6 py-3 rounded-lg font-display font-semibold text-xs sm:text-sm uppercase tracking-wider transition-colors bg-primary text-white"
      data-form="appointment"
      onclick="switchForm('appointment')"
    >
      Request an Appointment
    </button>
    <button
      class="form-tab px-4 sm:px-6 py-3 rounded-lg font-display font-semibold text-xs sm:text-sm uppercase tracking-wider transition-colors bg-gray-100 text-primary"
      data-form="consultation"
      onclick="switchForm('consultation')"
    >
      Request a Free Consultation
    </button>
  </div>
)}

<!-- Appointment Form -->
<div id="appointment-form" class={`form-panel ${formType === 'consultation' ? 'hidden' : ''}`}>
  <h2 class="text-2xl font-display font-bold uppercase tracking-wider text-primary mb-2">Book Your Appointment</h2>
  <p class="text-text-secondary mb-6">Already a patient or ready to book a specific treatment? Fill out the form below and we'll confirm your appointment.</p>

  <form name="appointment" method="POST" data-netlify="true" class="space-y-4">
    <input type="hidden" name="form-name" value="appointment">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="apt-first-name" class="block text-sm font-semibold text-primary mb-1">First Name *</label>
        <input type="text" id="apt-first-name" name="first-name" required class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
      </div>
      <div>
        <label for="apt-last-name" class="block text-sm font-semibold text-primary mb-1">Last Name *</label>
        <input type="text" id="apt-last-name" name="last-name" required class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="apt-email" class="block text-sm font-semibold text-primary mb-1">Email Address *</label>
        <input type="email" id="apt-email" name="email" required class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
      </div>
      <div>
        <label for="apt-phone" class="block text-sm font-semibold text-primary mb-1">Phone Number *</label>
        <input type="tel" id="apt-phone" name="phone" required class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
      </div>
    </div>
    <div>
      <label for="apt-treatment" class="block text-sm font-semibold text-primary mb-1">Treatment Required *</label>
      <select id="apt-treatment" name="treatment" required class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
        <option value="">Please select...</option>
        <optgroup label="Dental Treatments">
          <option value="check-up">Check-Up & Hygiene</option>
          <option value="emergency">Emergency Appointment</option>
          <option value="whitening">Teeth Whitening</option>
          <option value="bonding">Composite Bonding</option>
          <option value="veneers">Veneers</option>
          <option value="invisalign">Invisalign / Clear Aligners</option>
          <option value="braces">Fixed Braces</option>
          <option value="fillings">Fillings</option>
          <option value="root-canal">Root Canal Treatment</option>
          <option value="crown">Crown</option>
          <option value="implant">Dental Implant</option>
          <option value="dentures">Dentures</option>
        </optgroup>
        <optgroup label="Facial Aesthetics">
          <option value="wrinkle-reduction">Wrinkle Reduction</option>
          <option value="dermal-fillers">Dermal Fillers</option>
          <option value="profhilo">Profhilo</option>
          <option value="sunekos">Sunekos</option>
          <option value="chemical-peel">Chemical Peel</option>
          <option value="microneedling">Microneedling</option>
        </optgroup>
        <option value="other">Other</option>
      </select>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="apt-date" class="block text-sm font-semibold text-primary mb-1">Preferred Date</label>
        <input type="date" id="apt-date" name="preferred-date" class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
      </div>
      <div>
        <label for="apt-time" class="block text-sm font-semibold text-primary mb-1">Preferred Time</label>
        <select id="apt-time" name="preferred-time" class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
          <option value="">No preference</option>
          <option value="morning">Morning (8am-12pm)</option>
          <option value="afternoon">Afternoon (12pm-5pm)</option>
          <option value="evening">Evening (5pm-8pm)</option>
        </select>
      </div>
    </div>
    <div>
      <label for="apt-message" class="block text-sm font-semibold text-primary mb-1">Additional Information</label>
      <textarea id="apt-message" name="message" rows="4" placeholder="Please provide any additional details about your appointment request..." class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors resize-y"></textarea>
    </div>
    <div class="space-y-3">
      <label class="flex items-start gap-3 cursor-pointer">
        <input type="checkbox" name="existing-patient" class="mt-1 w-4 h-4 text-primary border-border-light rounded focus:ring-primary">
        <span class="text-sm text-text-primary">I am an existing patient</span>
      </label>
      <label class="flex items-start gap-3 cursor-pointer">
        <input type="checkbox" name="consent" required class="mt-1 w-4 h-4 text-primary border-border-light rounded focus:ring-primary">
        <span class="text-sm text-text-primary">I consent to ProDenta storing my information to process this request *</span>
      </label>
    </div>
    <button type="submit" class="cta-button w-full md:w-auto">Submit Appointment Request</button>
  </form>
</div>

<!-- Consultation Form -->
<div id="consultation-form" class={`form-panel ${formType !== 'consultation' && showBoth ? 'hidden' : ''} ${formType === 'appointment' ? 'hidden' : ''}`}>
  <h2 class="text-2xl font-display font-bold uppercase tracking-wider text-primary mb-2">Request Your Free Consultation</h2>
  <p class="text-text-secondary mb-6">New to ProDenta or exploring your treatment options? Book a free consultation to discuss your needs with our expert team.</p>

  <form name="consultation" method="POST" data-netlify="true" class="space-y-4">
    <input type="hidden" name="form-name" value="consultation">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="con-first-name" class="block text-sm font-semibold text-primary mb-1">First Name *</label>
        <input type="text" id="con-first-name" name="first-name" required class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
      </div>
      <div>
        <label for="con-last-name" class="block text-sm font-semibold text-primary mb-1">Last Name *</label>
        <input type="text" id="con-last-name" name="last-name" required class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="con-email" class="block text-sm font-semibold text-primary mb-1">Email Address *</label>
        <input type="email" id="con-email" name="email" required class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
      </div>
      <div>
        <label for="con-phone" class="block text-sm font-semibold text-primary mb-1">Phone Number *</label>
        <input type="tel" id="con-phone" name="phone" required class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
      </div>
    </div>
    <div>
      <label for="con-interest" class="block text-sm font-semibold text-primary mb-1">Area of Interest *</label>
      <select id="con-interest" name="interest" required class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
        <option value="">Please select...</option>
        <optgroup label="Cosmetic Dentistry">
          <option value="smile-makeover">Complete Smile Makeover</option>
          <option value="teeth-whitening">Teeth Whitening</option>
          <option value="composite-bonding">Composite Bonding</option>
          <option value="veneers">Veneers</option>
        </optgroup>
        <optgroup label="Orthodontics">
          <option value="invisalign">Invisalign</option>
          <option value="braces">Braces</option>
          <option value="orthodontics">General Orthodontics</option>
        </optgroup>
        <optgroup label="Restorative">
          <option value="dental-implants">Dental Implants</option>
          <option value="dentures">Dentures</option>
          <option value="crowns-bridges">Crowns & Bridges</option>
        </optgroup>
        <optgroup label="Facial Aesthetics">
          <option value="anti-wrinkle">Anti-Wrinkle Treatments</option>
          <option value="dermal-fillers">Dermal Fillers</option>
          <option value="skin-treatments">Skin Rejuvenation</option>
        </optgroup>
        <option value="general">General Dental Health</option>
        <option value="unsure">Not Sure / Multiple Treatments</option>
      </select>
    </div>
    <div>
      <label for="con-concerns" class="block text-sm font-semibold text-primary mb-1">What are your main concerns? *</label>
      <textarea id="con-concerns" name="concerns" rows="4" required placeholder="Tell us about your goals and concerns..." class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors resize-y"></textarea>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label for="con-date" class="block text-sm font-semibold text-primary mb-1">Preferred Consultation Date</label>
        <input type="date" id="con-date" name="preferred-date" class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
      </div>
      <div>
        <label for="con-time" class="block text-sm font-semibold text-primary mb-1">Preferred Time</label>
        <select id="con-time" name="preferred-time" class="w-full px-4 py-3 rounded-lg border border-border-light focus:border-primary focus:ring-1 focus:ring-primary outline-none transition-colors">
          <option value="">No preference</option>
          <option value="morning">Morning (8am-12pm)</option>
          <option value="afternoon">Afternoon (12pm-5pm)</option>
          <option value="evening">Evening (5pm-8pm)</option>
        </select>
      </div>
    </div>
    <div>
      <label class="block text-sm font-semibold text-primary mb-2">How did you hear about us?</label>
      <div class="flex flex-wrap gap-4">
        <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="referral" value="google" class="text-primary"><span class="text-sm">Google Search</span></label>
        <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="referral" value="social-media" class="text-primary"><span class="text-sm">Social Media</span></label>
        <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="referral" value="friend" class="text-primary"><span class="text-sm">Friend/Family</span></label>
        <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="referral" value="walk-by" class="text-primary"><span class="text-sm">Walked Past</span></label>
        <label class="flex items-center gap-2 cursor-pointer"><input type="radio" name="referral" value="other" class="text-primary"><span class="text-sm">Other</span></label>
      </div>
    </div>
    <div class="space-y-3">
      <label class="flex items-start gap-3 cursor-pointer">
        <input type="checkbox" name="consent" required class="mt-1 w-4 h-4 text-primary border-border-light rounded focus:ring-primary">
        <span class="text-sm text-text-primary">I consent to ProDenta storing my information to process this request *</span>
      </label>
      <label class="flex items-start gap-3 cursor-pointer">
        <input type="checkbox" name="marketing" class="mt-1 w-4 h-4 text-primary border-border-light rounded focus:ring-primary">
        <span class="text-sm text-text-primary">I would like to receive news and special offers from ProDenta</span>
      </label>
    </div>
    <button type="submit" class="cta-button w-full md:w-auto">Request Free Consultation</button>
  </form>
</div>

{showBoth && (
  <script is:inline>
    function switchForm(type) {
      document.getElementById('appointment-form').classList.toggle('hidden', type !== 'appointment');
      document.getElementById('consultation-form').classList.toggle('hidden', type !== 'consultation');
      document.querySelectorAll('.form-tab').forEach(tab => {
        const isActive = tab.dataset.form === type;
        tab.classList.toggle('bg-primary', isActive);
        tab.classList.toggle('text-white', isActive);
        tab.classList.toggle('bg-gray-100', !isActive);
        tab.classList.toggle('text-primary', !isActive);
        tab.classList.toggle('active', isActive);
      });
    }
  </script>
)}
