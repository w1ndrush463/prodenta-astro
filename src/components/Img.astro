---
// Optimised, responsive image from a content path. Shows a quiet placeholder
// if the image is missing, so an empty CMS field never breaks a page.
import { Image } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  src?: string | null;
  alt?: string;
  /** Tailwind classes for the wrapper: set the aspect ratio / size here. */
  class?: string;
  sizes?: string;
  /** Largest rendered width in CSS pixels (image is served up to 2x this). */
  width?: number;
  priority?: boolean;
  position?: string;
}

const {
  src,
  alt = '',
  class: className = '',
  sizes = '(min-width: 1024px) 50vw, 100vw',
  width = 900,
  priority = false,
  position = 'center',
} = Astro.props;

const meta = resolveImage(src);
const max = meta ? Math.min(meta.width, width * 2) : 0;
const widths = meta
  ? [...new Set([360, 540, 720, 960, 1280, 1600, 2000].filter((w) => w < max).concat(max))]
  : [];
---

<div class:list={['overflow-hidden bg-fog', className]}>
  {meta ? (
    <Image
      src={meta}
      alt={alt}
      widths={widths}
      sizes={sizes}
      quality={72}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding={priority ? 'sync' : 'async'}
      class="h-full w-full object-cover"
      style={`object-position:${position}`}
    />
  ) : (
    <div class="flex h-full w-full items-center justify-center" role={alt ? 'img' : undefined} aria-label={alt || undefined}>
      <svg viewBox="0 0 24 24" class="h-8 w-8 text-ink/25" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
        <rect x="3" y="4" width="18" height="16" rx="1" /><circle cx="9" cy="10" r="1.6" /><path d="m4 18 5.5-5 4 3.5 3-2.5L21 18" />
      </svg>
    </div>
  )}
</div>
