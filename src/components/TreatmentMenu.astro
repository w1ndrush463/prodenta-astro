---
// Treatments set out like a clinic menu: category, then name, one line and price.
import { groupedTreatments, urlOf, type TreatmentType } from '../lib/content';

interface Props {
  type: TreatmentType;
  /** Compact: names only, for the homepage. */
  compact?: boolean;
}
const { type, compact = false } = Astro.props;
const groups = await groupedTreatments(type);
---

{compact ? (
  <div class="grid gap-x-10 gap-y-7 sm:grid-cols-2">
    {groups.map((g) => (
      <div>
        <h3 class="label mb-2">{g.title}</h3>
        <ul>
          {g.items.map((t) => (
            <li><a href={urlOf(t)} class="block py-1 text-[1.05rem] text-ink underline-offset-4 hover:underline">{t.data.title}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>
) : (
  <div class="space-y-16 lg:space-y-24">
    {groups.map((g) => (
      <section id={g.id} class="grid gap-6 lg:grid-cols-12 lg:gap-12" aria-labelledby={`cat-${type}-${g.id}`}>
        <div class="lg:col-span-4">
          <h2 id={`cat-${type}-${g.id}`} class="text-title">{g.title}</h2>
          <p class="mt-3 max-w-xs text-muted">{g.text}</p>
        </div>
        <ul class="border-t border-line lg:col-span-8">
          {g.items.map((t) => (
            <li class="border-b border-line">
              <a href={urlOf(t)} class="group grid gap-x-8 gap-y-1 py-5 sm:grid-cols-[1fr_auto] sm:items-baseline">
                <span>
                  <span class="block font-display text-[1.45rem] leading-tight text-ink underline-offset-4 group-hover:underline">{t.data.title}</span>
                  <span class="mt-1 block text-muted">{t.data.summary}</span>
                </span>
                {t.data.price && <span class="font-semibold text-ink sm:text-right">{t.data.price}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
)}
