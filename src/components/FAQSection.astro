---
interface FAQ {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  faqs: FAQ[];
  theme?: 'dental' | 'aesthetics';
}

const { title = 'Frequently Asked Questions', faqs, theme = 'dental' } = Astro.props;

const isDental = theme === 'dental';
const sectionBg = isDental ? 'bg-white' : 'bg-primary';
const titleColor = isDental ? 'text-primary' : 'text-accent-light';
const itemBg = isDental ? 'bg-gray-50 border border-gray-200' : 'bg-white/10';
const questionColor = isDental ? 'text-primary' : 'text-accent-light';
const answerColor = isDental ? 'text-gray-600' : 'text-white/80';
---

<section class={`section-padding ${sectionBg}`}>
  <div class="max-w-4xl mx-auto">
    <h2 class={`text-section font-display font-bold uppercase tracking-wider ${titleColor} text-center mb-12`}>{title}</h2>
    <div class="space-y-4">
      {faqs.map((faq) => (
        <div class={`${itemBg} rounded-xl overflow-hidden faq-item`}>
          <button
            class={`w-full text-left px-6 py-4 flex items-center justify-between cursor-pointer ${questionColor} font-display font-semibold uppercase tracking-wider text-sm`}
            onclick="this.parentElement.classList.toggle('open')"
          >
            <span>{faq.question}</span>
            <span class="faq-icon text-xl transition-transform duration-300">+</span>
          </button>
          <div class="faq-answer px-6 overflow-hidden max-h-0 transition-all duration-300">
            <p class={`${answerColor} pb-4 leading-relaxed`}>{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item.open .faq-answer {
    max-height: 500px;
  }
  .faq-item.open .faq-icon {
    transform: rotate(45deg);
  }
</style>
