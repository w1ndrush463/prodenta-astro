---
// One template for every dental and aesthetics treatment page.
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import Img from './Img.astro';
import Faqs from './Faqs.astro';
import Booking from './Booking.astro';
import { typeOf, typeLabel, typeIndexUrl, urlOf, type Treatment } from '../lib/content';

interface Props {
  treatment: Treatment;
}
const { treatment } = Astro.props;
const t = treatment.data;
const type = typeOf(treatment);
const { Content } = await render(treatment);

const related = (
  await Promise.all(t.related.slice(0, 3).map((ref) => {
    // Accepts "dental/veneers" or the full file path the CMS stores.
    const m = /(dental|aesthetics)\/([^/.]+)(?:\.md)?$/.exec(ref);
    return m ? getEntry('treatments', `${m[1]}/${m[2]}`) : undefined;
  }))
).filter((r): r is Treatment => Boolean(r));
const gallery = t.gallery.filter((g) => g.image);

const breadcrumbs = [
  { label: 'Home', url: '/' },
  { label: typeLabel(type), url: typeIndexUrl(type) },
  { label: t.title },
];
const faqSchema = t.faqs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: t.faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : undefined;
const surface = type === 'aesthetics' ? 'bg-shell' : 'bg-mist';
---

<BaseLayout
  title={t.seo.title || t.title}
  description={t.seo.description || t.intro}
  image={t.image}
  breadcrumbs={breadcrumbs}
  schema={faqSchema ? [faqSchema] : []}
  tone={type === 'aesthetics' ? 'aesthetics' : 'default'}
>
  <PageHero heading={t.title} intro={t.intro} image={t.image} imageAlt={t.imageAlt} breadcrumbs={breadcrumbs} surface={surface}>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <a href="/contact" class="btn">Book a consultation</a>
      {t.price && <p class="font-semibold text-ink">{t.price}</p>}
    </div>
  </PageHero>

  <!-- Key facts -->
  {t.facts.length > 0 && (
    <section class="border-b border-line" aria-label="At a glance">
      <dl class="wrap grid grid-cols-2 gap-x-8 gap-y-6 py-8 lg:grid-cols-4 lg:py-10">
        {t.facts.slice(0, 4).map((f) => (
          <div>
            <dt class="label">{f.label}</dt>
            <dd class="mt-1 text-lg leading-snug text-ink">{f.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  )}

  <!-- Overview -->
  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-12">
      <div class="prose-site lg:col-span-7">
        <Content />
      </div>
      {t.helpsWith.length > 0 && (
        <aside class="lg:col-span-4 lg:col-start-9">
          <div class:list={[surface, 'shape-soft p-7 lg:sticky lg:top-28 lg:p-9']}>
            <h2 class="text-subtitle">It can help with</h2>
            <ul class="mt-5 space-y-4">
              {t.helpsWith.map((h) => (
                <li>
                  <p class="font-semibold text-ink">{h.title}</p>
                  {h.text && <p class="text-[0.975rem]">{h.text}</p>}
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </section>

  <!-- How it works -->
  {t.steps.length > 0 && (
    <section class="pb-[var(--spacing-section)]">
      <div class="wrap">
        <h2 class="text-title">{t.stepsHeading || 'What happens'}</h2>
        <ol class="mt-8 grid gap-x-12 border-t border-line md:grid-cols-2">
          {t.steps.map((s, i) => (
            <li class="flex gap-5 border-b border-line py-6">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-[1.5px] border-teal/50 font-semibold text-teal" aria-hidden="true">{i + 1}</span>
              <div>
                {s.title && <h3 class="mb-1.5 font-sans text-lg font-semibold">{s.title}</h3>}
                <p>{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- Things to know + price -->
  {(t.benefits.length > 0 || t.price) && (
    <section class:list={['section', surface]}>
      <div class="wrap grid gap-12 lg:grid-cols-12">
        {t.benefits.length > 0 && (
          <div class="lg:col-span-7">
            <h2 class="text-title">Good to know</h2>
            <dl class="mt-8 space-y-6">
              {t.benefits.map((b) => (
                <div>
                  <dt class="text-lg font-semibold text-ink">{b.title}</dt>
                  <dd class="mt-1 max-w-xl">{b.text}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
        {t.price && (
          <div class="lg:col-span-4 lg:col-start-9">
            <div class="shape-soft bg-white p-7 lg:p-9">
              <p class="label">Fees</p>
              <p class="mt-2 font-display text-[2rem] leading-[1.15] text-ink">{t.price}</p>
              {t.priceNote && <p class="mt-4 text-[0.975rem]">{t.priceNote}</p>}
              <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-4">
                <a href="/contact" class="btn">Book a consultation</a>
                <a href="/fees" class="link">All fees</a>
              </div>
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Results gallery: only appears once real photos are added in the CMS -->
  {gallery.length > 0 && (
    <section class="section border-t border-line">
      <div class="wrap">
        <h2 class="text-title">Before and after</h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {gallery.map((g) => (
            <figure>
              <Img src={g.image} alt={g.caption || `${t.title} result`} class="shape-soft aspect-[4/3]" sizes="(min-width: 1024px) 33vw, 100vw" width={500} />
              {g.caption && <figcaption class="mt-3 text-sm text-muted">{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
        <p class="mt-6 text-sm text-muted">Individual results vary.</p>
      </div>
    </section>
  )}

  <Faqs faqs={t.faqs} />

  {related.length > 0 && (
    <section class="pb-[var(--spacing-section)]">
      <div class="wrap">
        <h2 class="text-subtitle">Related treatments</h2>
        <ul class="mt-7 grid gap-8 md:grid-cols-3">
          {related.map((r) => (
            <li>
              <a href={urlOf(r)} class="group block">
                <Img src={r.data.image} alt="" class="shape-soft aspect-[3/2]" sizes="(min-width: 768px) 33vw, 100vw" width={450} />
                <p class="mt-4 text-lg font-semibold text-ink underline-offset-4 group-hover:underline">{r.data.title}</p>
                <p class="mt-0.5 text-muted">{r.data.summary}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Booking />
</BaseLayout>
