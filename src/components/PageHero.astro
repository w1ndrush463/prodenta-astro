---
// Standard page opening: breadcrumb, heading, intro and a shaped photo.
import Shaped from './Shaped.astro';

interface Props {
  heading: string;
  intro?: string;
  image?: string;
  imageAlt?: string;
  breadcrumbs?: { label: string; url?: string }[];
  surface?: string;
}
const { heading, intro, image, imageAlt, breadcrumbs = [], surface = 'bg-mist' } = Astro.props;
---

<section class={surface}>
  <div class="wrap grid items-center gap-10 py-10 lg:grid-cols-12 lg:gap-8 lg:py-16">
    <div class="lg:col-span-7">
      {breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="flex flex-wrap gap-x-2 text-sm text-muted">
            {breadcrumbs.map((b, i) => (
              <li class="flex gap-2">
                {b.url ? <a href={b.url} class="underline-offset-4 hover:text-ink hover:underline">{b.label}</a> : <span aria-current="page" class="text-ink">{b.label}</span>}
                {i < breadcrumbs.length - 1 && <span aria-hidden="true">/</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
      <h1 class="text-display max-w-[16ch]">{heading}</h1>
      {intro && <p class="mt-6 max-w-xl text-lead">{intro}</p>}
      <slot />
    </div>
    <Shaped
      src={image}
      alt={imageAlt}
      ratio="aspect-[5/6]"
      class="mx-auto w-full max-w-sm lg:col-span-4 lg:col-start-9 lg:max-w-none"
      sizes="(min-width: 1024px) 30vw, 80vw"
      width={520}
      priority
    />
  </div>
</section>
