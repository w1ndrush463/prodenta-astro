---
import { Image } from 'astro:assets';
import logo from '../assets/images/prodenta-logo.png';
import { site as getSite, setting, groupedTreatments, telHref, urlOf } from '../lib/content';

const site = await getSite();
const nav = await setting('navigation');
const [dental, aesthetics] = await Promise.all([groupedTreatments('dental'), groupedTreatments('aesthetics')]);

const menus = [
  { id: 'dental', label: 'Dental', all: 'All dental treatments', url: '/treatments', groups: dental },
  { id: 'aesthetics', label: 'Aesthetics', all: 'All aesthetic treatments', url: '/facial-aesthetics-treatments', groups: aesthetics },
];
const links: { label: string; url: string }[] = nav.header ?? [];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (url: string) => path === url || path.startsWith(`${url}/`);
---

<header class="sticky top-0 z-50 border-b border-line bg-white" data-header>
  <div class="wrap flex h-[4.25rem] items-center justify-between gap-6 lg:h-20">
    <a href="/" class="shrink-0" aria-label={`${site.name} home`}>
      <Image src={logo} alt={site.name} width={166} height={44} loading="eager" class="h-9 w-auto lg:h-11" />
    </a>

    <nav class="hidden lg:block" aria-label="Main">
      <ul class="flex items-center gap-7 xl:gap-9">
        {menus.map((m) => (
          <li data-menu>
            <button
              type="button"
              class="nav-link flex items-center gap-1.5"
              aria-expanded="false"
              aria-controls={`menu-${m.id}`}
              data-menu-button
            >
              {m.label}
              <svg viewBox="0 0 12 12" class="h-2.5 w-2.5 transition-transform" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="m2 4 4 4 4-4" /></svg>
            </button>
            <div id={`menu-${m.id}`} class="menu-panel absolute inset-x-0 top-full hidden border-b border-line bg-white shadow-[0_30px_40px_-30px_rgba(23,63,74,0.3)]" data-menu-panel>
              <div class="wrap grid gap-10 py-10" style={`grid-template-columns: repeat(${m.groups.length}, minmax(0, 1fr))`}>
                {m.groups.map((g) => (
                  <div>
                    <p class="label mb-3">{g.title}</p>
                    <ul class="space-y-2">
                      {g.items.map((t) => (
                        <li><a href={urlOf(t)} class="text-ink underline-offset-4 hover:underline">{t.data.title}</a></li>
                      ))}
                    </ul>
                  </div>
                ))}
              </div>
              <div class="bg-mist">
                <div class="wrap py-4"><a href={m.url} class="link">{m.all}</a></div>
              </div>
            </div>
          </li>
        ))}
        {links.map((l) => (
          <li><a href={l.url} class="nav-link" aria-current={isCurrent(l.url) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-5">
      <a href={telHref(site.phone)} class="hidden font-semibold text-ink xl:block">{site.phone}</a>
      <a href="/contact" class="btn hidden !min-h-11 !px-6 !py-2 sm:inline-flex">Book</a>
      <button type="button" class="-mr-2 flex h-11 w-11 items-center justify-center text-ink lg:hidden" aria-label="Open menu" data-mobile-open>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 8h16M4 16h16" /></svg>
      </button>
    </div>
  </div>
</header>

<dialog class="mobile-menu m-0 h-dvh max-h-none w-full max-w-none bg-white p-0 text-body" aria-label="Menu" data-mobile-menu>
  <div class="flex h-full flex-col">
    <div class="wrap flex h-[4.5rem] shrink-0 items-center justify-between border-b border-line">
      <span class="font-semibold text-ink">Menu</span>
      <button type="button" class="-mr-2 flex h-11 w-11 items-center justify-center text-ink" aria-label="Close menu" data-mobile-close>
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" /></svg>
      </button>
    </div>
    <nav class="wrap flex-1 overflow-y-auto py-6" aria-label="Mobile">
      {menus.map((m) => (
        <details class="group border-b border-line">
          <summary class="flex items-center justify-between py-4 font-display text-2xl text-ink">
            {m.label}
            <svg viewBox="0 0 12 12" class="h-3.5 w-3.5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="m2 4 4 4 4-4" /></svg>
          </summary>
          <div class="space-y-6 pb-6">
            {m.groups.map((g) => (
              <div>
                <p class="label mb-2">{g.title}</p>
                <ul>
                  {g.items.map((t) => (
                    <li><a href={urlOf(t)} class="block py-1.5 text-lg text-ink">{t.data.title}</a></li>
                  ))}
                </ul>
              </div>
            ))}
            <a href={m.url} class="link">{m.all}</a>
          </div>
        </details>
      ))}
      {links.map((l) => (
        <a href={l.url} class="block border-b border-line py-4 font-display text-2xl text-ink">{l.label}</a>
      ))}
    </nav>
    <div class="wrap grid shrink-0 grid-cols-2 gap-3 border-t border-line py-5">
      <a href="/contact" class="btn">Book</a>
      <a href={telHref(site.phone)} class="btn btn-outline">Call</a>
    </div>
  </div>
</dialog>

<style>
  .nav-link {
    font-size: 0.975rem;
    font-weight: 500;
    color: var(--color-ink);
    padding-block: 0.4rem;
    border-bottom: 1.5px solid transparent;
    transition: border-color 0.2s ease;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'],
  .nav-link[aria-expanded='true'] {
    border-bottom-color: currentColor;
  }
  .nav-link[aria-expanded='true'] svg { transform: rotate(180deg); }
  [data-menu-button][aria-expanded='true'] + .menu-panel { display: block; }
  .mobile-menu::backdrop { background: rgb(23 63 74 / 0.35); }
</style>

<script>
  // Desktop dropdowns: click or hover to open, Escape or click-away to close.
  const menus = [...document.querySelectorAll<HTMLElement>('[data-menu]')];
  const closeAll = (except?: HTMLElement) => {
    for (const m of menus) {
      if (m !== except) m.querySelector('[data-menu-button]')?.setAttribute('aria-expanded', 'false');
    }
  };
  const hoverable = window.matchMedia('(hover: hover) and (pointer: fine)');
  for (const m of menus) {
    const button = m.querySelector<HTMLButtonElement>('[data-menu-button]')!;
    let timer: number | undefined;
    button.addEventListener('click', () => {
      const open = button.getAttribute('aria-expanded') === 'true';
      closeAll(m);
      button.setAttribute('aria-expanded', String(!open));
    });
    m.addEventListener('mouseenter', () => {
      if (!hoverable.matches) return;
      window.clearTimeout(timer);
      closeAll(m);
      button.setAttribute('aria-expanded', 'true');
    });
    m.addEventListener('mouseleave', () => {
      if (!hoverable.matches) return;
      timer = window.setTimeout(() => button.setAttribute('aria-expanded', 'false'), 160);
    });
    m.addEventListener('focusout', (e) => {
      if (!m.contains(e.relatedTarget as Node | null)) button.setAttribute('aria-expanded', 'false');
    });
  }
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = menus.find((m) => m.querySelector('[aria-expanded="true"]'));
    if (open) {
      closeAll();
      open.querySelector<HTMLButtonElement>('[data-menu-button]')?.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!menus.some((m) => m.contains(e.target as Node))) closeAll();
  });

  // Mobile menu uses a native <dialog>: focus trapping and Escape come free.
  const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-menu]');
  document.querySelector('[data-mobile-open]')?.addEventListener('click', () => dialog?.showModal());
  document.querySelector('[data-mobile-close]')?.addEventListener('click', () => dialog?.close());
</script>
