---
import { site } from '../data/site';
import { dentalDropdown, aestheticsDropdown, mainNavLinks } from '../data/navigation';
---

<header class="sticky top-0 z-50 bg-white shadow-soft">
  <div class="max-w-7xl mx-auto">
    <!-- Top Bar -->
    <div class="flex items-center justify-between px-4 md:px-8 py-3">
      <a href="/" class="shrink-0">
        <img src="/images/prodenta-logo blue.png" alt="ProDenta" class="h-10 md:h-12">
      </a>

      <div class="hidden md:flex items-center gap-6">
        <div class="text-sm">
          <p class="font-semibold">Call us now: <a href={site.phoneHref} class="text-primary hover:text-secondary">{site.phone}</a></p>
          <p class="font-semibold">WhatsApp us now: <a href={site.whatsappHref} class="text-primary hover:text-secondary">{site.whatsapp}</a></p>
        </div>
        <div class="flex items-center gap-3">
          <a href={site.social.instagram} target="_blank" aria-label="Instagram" class="opacity-70 hover:opacity-100 transition-opacity">
            <img src="/icons/instagram.png" alt="Instagram" class="w-6 h-6">
          </a>
          <a href={site.social.facebook} target="_blank" aria-label="Facebook" class="opacity-70 hover:opacity-100 transition-opacity">
            <img src="/icons/facebook.png" alt="Facebook" class="w-6 h-6">
          </a>
          <a href={site.emailHref} aria-label="Email" class="opacity-70 hover:opacity-100 transition-opacity">
            <img src="/icons/mail.png" alt="Email" class="w-6 h-6">
          </a>
        </div>
      </div>

      <!-- Hamburger -->
      <button class="md:hidden flex flex-col gap-1.5 p-2 hamburger-menu" onclick="toggleMobileMenu()" aria-label="Menu">
        <span class="block w-6 h-0.5 bg-primary transition-all hamburger-line"></span>
        <span class="block w-6 h-0.5 bg-primary transition-all hamburger-line"></span>
        <span class="block w-6 h-0.5 bg-primary transition-all hamburger-line"></span>
      </button>
    </div>

    <!-- Desktop Nav -->
    <nav class="hidden md:block border-t border-border-light">
      <ul class="flex items-center justify-center gap-0 px-4">
        <!-- Dental Treatments Dropdown -->
        <li class="relative group">
          <a href={dentalDropdown.href} class="block px-4 py-3 text-xs font-display font-semibold uppercase tracking-wider text-primary hover:text-secondary transition-colors">
            {dentalDropdown.label}
          </a>
          <div class="absolute left-1/2 -translate-x-1/2 top-full hidden group-hover:block bg-white shadow-deep rounded-lg p-6 min-w-[700px] z-50">
            <div class="grid grid-cols-5 gap-6">
              {dentalDropdown.columns.map((col) => (
                <div>
                  <h4 class="font-display font-semibold text-xs uppercase tracking-wider text-secondary mb-3">{col.heading}</h4>
                  <ul class="space-y-2">
                    {col.items.map((item) => (
                      <li><a href={item.href} class="text-sm text-text-primary hover:text-primary transition-colors">{item.label}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </li>

        <!-- Aesthetics Dropdown -->
        <li class="relative group">
          <a href={aestheticsDropdown.href} class="block px-4 py-3 text-xs font-display font-semibold uppercase tracking-wider text-primary hover:text-secondary transition-colors">
            {aestheticsDropdown.label}
          </a>
          <div class="absolute left-1/2 -translate-x-1/2 top-full hidden group-hover:block bg-white shadow-deep rounded-lg p-6 min-w-[500px] z-50">
            <div class="grid grid-cols-3 gap-6">
              {aestheticsDropdown.columns.map((col) => (
                <div>
                  <h4 class="font-display font-semibold text-xs uppercase tracking-wider text-secondary mb-3">{col.heading}</h4>
                  <ul class="space-y-2">
                    {col.items.map((item) => (
                      <li><a href={item.href} class="text-sm text-text-primary hover:text-primary transition-colors">{item.label}</a></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </li>

        {mainNavLinks.map((link) => (
          <li>
            <a href={link.href} class="block px-4 py-3 text-xs font-display font-semibold uppercase tracking-wider text-primary hover:text-secondary transition-colors">
              {link.label}
            </a>
          </li>
        ))}

        <!-- Book Now -->
        <li class="relative group">
          <button class="px-5 py-2 bg-primary text-white text-xs font-display font-semibold uppercase tracking-wider rounded hover:bg-secondary transition-colors ml-2">
            Book Now
          </button>
          <div class="absolute right-0 top-full hidden group-hover:block bg-white shadow-deep rounded-lg py-2 min-w-[220px] z-50">
            <a href="/contact#appointment" class="block px-4 py-2 text-sm text-text-primary hover:bg-bg-alt hover:text-primary transition-colors">Book an Appointment</a>
            <a href="/contact#consultation" class="block px-4 py-2 text-sm text-text-primary hover:bg-bg-alt hover:text-primary transition-colors">Book a Free Consultation</a>
          </div>
        </li>

        <li>
          <a href={site.phoneHref} class="px-5 py-2 bg-primary text-white text-xs font-display font-semibold uppercase tracking-wider rounded hover:bg-secondary transition-colors ml-2 inline-block">
            Call Us
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
