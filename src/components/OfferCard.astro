---
interface Props {
  title: string;
  price: string;
  description: string;
}

const { title, price, description } = Astro.props;
---

<div class="bg-white rounded-xl shadow-soft p-6 text-center border-2 border-accent hover:border-primary transition-colors">
  <h3 class="font-display font-semibold uppercase tracking-wider text-sm text-primary mb-3">{title}</h3>
  <div class="text-3xl font-display font-bold text-primary mb-3">{price}</div>
  <p class="text-sm text-text-secondary">{description}</p>
</div>
