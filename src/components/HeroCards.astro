---
interface Props {
  cards: { title: string; description: string }[];
  theme?: 'dental' | 'aesthetics';
}

const { cards, theme = 'dental' } = Astro.props;

const cardBg = theme === 'aesthetics' ? 'bg-accent-light text-primary' : 'bg-primary text-white';
---

<section class="bg-bg-alt py-6">
  <div class="max-w-5xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {cards.map((card) => (
        <div class={`${cardBg} rounded-xl p-6 text-center shadow-soft`}>
          <h3 class="font-display font-semibold uppercase tracking-wider text-sm mb-2">{card.title}</h3>
          <p class="text-sm opacity-90">{card.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
