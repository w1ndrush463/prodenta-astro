---
interface Category {
  label: string;
  href: string;
}

interface Props {
  categories: Category[];
}

const { categories } = Astro.props;
---

<nav class="sticky top-[72px] z-40 bg-white border-b border-border-light shadow-sm">
  <div class="max-w-7xl mx-auto px-4 py-3 flex gap-3 overflow-x-auto scrollbar-hide">
    {categories.map((cat) => (
      <a
        href={cat.href}
        class="shrink-0 px-5 py-2 rounded-full border border-primary text-primary text-xs font-display font-semibold uppercase tracking-wider hover:bg-primary hover:text-white transition-colors"
      >
        {cat.label}
      </a>
    ))}
  </div>
</nav>
