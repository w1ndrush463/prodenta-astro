---
interface Problem {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  problems: Problem[];
  theme?: 'dental' | 'aesthetics';
}

const { title, problems, theme = 'dental' } = Astro.props;

const sectionBg = theme === 'dental' ? 'bg-white' : 'bg-primary';
const titleColor = theme === 'dental' ? 'text-primary' : 'text-accent-light';
const cardBg = theme === 'dental' ? 'bg-gray-50 border border-gray-200' : 'bg-white/10';
const cardTitle = theme === 'dental' ? 'text-primary' : 'text-accent-light';
const cardText = theme === 'dental' ? 'text-gray-600' : 'text-white/80';
---

<section class={`section-padding ${sectionBg}`}>
  <div class="max-w-7xl mx-auto">
    <h2 class={`text-section font-display font-bold uppercase tracking-wider ${titleColor} text-center mb-12`}>{title}</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-6">
      {problems.map((problem) => (
        <div class={`${cardBg} rounded-xl p-6 text-center`}>
          <div class="w-16 h-16 mx-auto mb-4">
            <img src={problem.icon} alt={problem.title} class="w-full h-full object-contain">
          </div>
          <h3 class={`font-display font-semibold uppercase tracking-wider text-sm ${cardTitle} mb-2`}>{problem.title}</h3>
          <p class={`text-sm ${cardText}`}>{problem.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
