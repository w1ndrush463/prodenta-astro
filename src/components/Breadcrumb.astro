---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
  light?: boolean;
}

const { items, light = false } = Astro.props;
const textClass = light ? 'text-white/80' : 'text-text-secondary';
const linkClass = light ? 'text-white/80 hover:text-white' : 'text-text-secondary hover:text-primary';
---

<nav class={`text-sm mb-4 ${textClass}`} aria-label="Breadcrumb">
  {items.map((item, i) => (
    <>
      {i > 0 && <span class="mx-2">/</span>}
      {item.href ? (
        <a href={item.href} class={`${linkClass} transition-colors`}>{item.label}</a>
      ) : (
        <span>{item.label}</span>
      )}
    </>
  ))}
</nav>
