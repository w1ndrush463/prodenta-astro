---
interface Props {
  title: string;
  description: string;
  image: string;
  href: string;
}

const { title, description, image, href } = Astro.props;
---

<a href={href} class="group block rounded-xl overflow-hidden shadow-soft hover:shadow-hover transition-all duration-300 hover:-translate-y-1 bg-white">
  <img src={image} alt={title} class="w-full aspect-[4/3] object-cover" loading="lazy">
  <div class="p-5">
    <h3 class="font-display font-semibold uppercase tracking-wider text-sm text-primary mb-2 group-hover:text-secondary transition-colors">{title}</h3>
    <p class="text-sm text-text-secondary mb-3">{description}</p>
    <span class="text-primary text-sm font-semibold group-hover:text-secondary transition-colors">Learn More &rarr;</span>
  </div>
</a>
