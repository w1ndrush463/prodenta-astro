---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="section">
    <div class="wrap wrap-narrow">
      <h1 class="text-display">We can't find that page</h1>
      <p class="mt-6 max-w-xl text-lead">The page may have moved or the link may be out of date.</p>
      <div class="mt-10 flex flex-wrap items-center gap-x-7 gap-y-5">
        <a href="/" class="btn">Back to home</a>
        <a href="/treatments" class="link">Dental treatments</a>
        <a href="/contact" class="link">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
