---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="section">
    <div class="wrap wrap-narrow text-center">
      <p class="eyebrow mb-6">Error 404</p>
      <h1 class="text-display">We can't find that page</h1>
      <p class="mx-auto mt-7 max-w-xl text-lead">It may have moved. Try one of these instead.</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-5">
        <a href="/" class="btn">Back to home</a>
        <a href="/treatments" class="link">Dental treatments</a>
        <a href="/contact" class="link">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>
