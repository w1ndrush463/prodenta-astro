---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import TreatmentMenu from '../components/TreatmentMenu.astro';
import Booking from '../components/Booking.astro';
import Visit from '../components/Visit.astro';
import { page } from '../lib/content';

const home = await page('home');
const reviews = await page('reviews');
const { hero = {}, welcome = {}, dental = {}, aesthetics = {}, offer = {}, reasons = {} } = home;
const highlights: { title: string; text: string }[] = home.highlights ?? [];
const all: { name: string; quote: string; featured?: boolean }[] = reviews.reviews ?? [];
const quote = all.find((r) => r.featured) ?? all[0];
---

<BaseLayout title={home.seo?.title} description={home.seo?.description} image={hero.image}>
  <!-- Hero -->
  <section class="bg-sand">
    <div class="grid lg:grid-cols-12">
      <div class="wrap flex flex-col justify-center py-16 lg:col-span-6 lg:max-w-none lg:py-28 lg:pl-[max(var(--spacing-gutter),calc((100vw-82rem)/2+var(--spacing-gutter)))] lg:pr-16">
        {hero.eyebrow && <p class="eyebrow mb-6">{hero.eyebrow}</p>}
        <h1 class="text-display max-w-[12ch]">{hero.heading}</h1>
        <p class="mt-7 max-w-md text-lead">{hero.text}</p>
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-5">
          {hero.primaryLabel && <a href={hero.primaryUrl || '/contact'} class="btn">{hero.primaryLabel}</a>}
          {hero.secondaryLabel && <a href={hero.secondaryUrl || '/treatments'} class="link">{hero.secondaryLabel} <span aria-hidden="true">&rarr;</span></a>}
        </div>
      </div>
      <Img src={hero.image} alt={hero.imageAlt} class="aspect-[5/4] lg:col-span-6 lg:aspect-auto lg:min-h-[42rem]" sizes="(min-width: 1024px) 50vw, 100vw" width={1000} priority />
    </div>
  </section>

  {highlights.length > 0 && (
    <section class="border-b border-line" aria-label="At a glance">
      <ul class="wrap grid divide-y divide-line md:grid-cols-3 md:divide-x md:divide-y-0">
        {highlights.map((h) => (
          <li class="py-7 md:px-10 md:py-10 md:first:pl-0 md:last:pr-0">
            <p class="font-display text-2xl text-ink">{h.title}</p>
            <p class="mt-1.5 text-muted">{h.text}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Welcome -->
  <section class="section">
    <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
      <Img src={welcome.image} alt={welcome.imageAlt} class="aspect-[4/5] lg:col-span-5" sizes="(min-width: 1024px) 40vw, 100vw" width={700} />
      <div class="lg:col-span-6 lg:col-start-7" data-reveal>
        {welcome.eyebrow && <p class="eyebrow mb-5">{welcome.eyebrow}</p>}
        <h2 class="text-title max-w-[16ch]">{welcome.heading}</h2>
        <div class="mt-8 space-y-5">
          {(welcome.paragraphs ?? []).map((p: string, i: number) => <p class:list={[i === 0 && 'text-lead text-ink']}>{p}</p>)}
        </div>
        {welcome.linkLabel && <p class="mt-10"><a href={welcome.linkUrl || '/about'} class="link">{welcome.linkLabel} <span aria-hidden="true">&rarr;</span></a></p>}
      </div>
    </div>
  </section>

  <!-- Dental -->
  <section class="section bg-sand">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-32" data-reveal>
          {dental.eyebrow && <p class="eyebrow mb-5">{dental.eyebrow}</p>}
          <h2 class="text-title">{dental.heading}</h2>
          <p class="mt-5 max-w-sm text-lead">{dental.text}</p>
          <Img src={dental.image} alt={dental.imageAlt} class="mt-10 aspect-[4/3]" sizes="(min-width: 1024px) 40vw, 100vw" width={700} />
        </div>
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <TreatmentMenu type="dental" compact />
        <p class="mt-10"><a href="/treatments" class="link">{dental.linkLabel || 'All dental treatments'} <span aria-hidden="true">&rarr;</span></a></p>
      </div>
    </div>
  </section>

  <!-- Aesthetics -->
  <section class="section bg-blush">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:order-2 lg:col-span-5 lg:col-start-8">
        <div class="lg:sticky lg:top-32" data-reveal>
          {aesthetics.eyebrow && <p class="eyebrow mb-5">{aesthetics.eyebrow}</p>}
          <h2 class="text-title">{aesthetics.heading}</h2>
          <p class="mt-5 max-w-sm text-lead">{aesthetics.text}</p>
          <Img src={aesthetics.image} alt={aesthetics.imageAlt} class="mt-10 aspect-[4/5]" sizes="(min-width: 1024px) 40vw, 100vw" width={700} />
        </div>
      </div>
      <div class="lg:order-1 lg:col-span-6">
        <TreatmentMenu type="aesthetics" compact />
        <p class="mt-10"><a href="/facial-aesthetics-treatments" class="link">{aesthetics.linkLabel || 'All aesthetic treatments'} <span aria-hidden="true">&rarr;</span></a></p>
      </div>
    </div>
  </section>

  <!-- New patient offer -->
  {offer.show !== false && offer.heading && (
    <section class="on-dark bg-ink">
      <div class="wrap grid items-end gap-10 py-20 lg:grid-cols-12 lg:py-28" data-reveal>
        <div class="lg:col-span-7">
          {offer.eyebrow && <p class="eyebrow mb-5">{offer.eyebrow}</p>}
          <h2 class="text-title max-w-[18ch]">{offer.heading}</h2>
          <p class="mt-6 max-w-lg text-lead">{offer.text}</p>
        </div>
        <div class="lg:col-span-4 lg:col-start-9 lg:text-right">
          <p class="font-display text-[5.5rem] leading-none text-ivory">{offer.price}</p>
          {offer.buttonLabel && <a href={offer.buttonUrl || '/contact'} class="btn btn-light mt-8">{offer.buttonLabel}</a>}
        </div>
      </div>
    </section>
  )}

  <!-- Patient quote -->
  {quote && (
    <section class="section">
      <figure class="wrap wrap-narrow text-center" data-reveal>
        <p class="eyebrow mb-8">In our patients' words</p>
        <blockquote class="font-display text-[clamp(1.9rem,1.3rem+2.6vw,3.25rem)] italic leading-[1.18] text-ink">
          &ldquo;{quote.quote}&rdquo;
        </blockquote>
        <figcaption class="mt-8 text-sm font-semibold uppercase tracking-[0.18em] text-muted">{quote.name}</figcaption>
        <p class="mt-10"><a href="/reviews" class="link">Read more reviews <span aria-hidden="true">&rarr;</span></a></p>
      </figure>
    </section>
  )}

  <!-- Why ProDenta -->
  <section class="section border-t border-line">
    <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6" data-reveal>
        {reasons.eyebrow && <p class="eyebrow mb-5">{reasons.eyebrow}</p>}
        <h2 class="text-title max-w-[15ch]">{reasons.heading}</h2>
        <ol class="mt-10 border-t border-ink/80">
          {(reasons.items ?? []).map((r: { title: string; text: string }, i: number) => (
            <li class="grid grid-cols-[3rem_1fr] gap-4 border-b border-line py-6">
              <span class="pt-1 text-sm tracking-widest text-clay" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="text-2xl">{r.title}</h3>
                <p class="mt-1 text-muted">{r.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <Img src={reasons.image} alt={reasons.imageAlt} class="aspect-[4/5] lg:col-span-5 lg:col-start-8" sizes="(min-width: 1024px) 40vw, 100vw" width={700} />
    </div>
  </section>

  <Booking />
  <Visit />
</BaseLayout>
