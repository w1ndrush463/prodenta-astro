---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import Shaped from '../components/Shaped.astro';
import TreatmentMenu from '../components/TreatmentMenu.astro';
import Booking from '../components/Booking.astro';
import Visit from '../components/Visit.astro';
import { page, site as getSite, telHref } from '../lib/content';

const home = await page('home');
const reviews = await page('reviews');
const site = await getSite();
const { hero = {}, welcome = {}, dental = {}, aesthetics = {}, offer = {}, reasons = {} } = home;
const hours: { days: string; times: string }[] = (site.hours ?? []).filter((h: { times: string }) => !/closed/i.test(h.times ?? ''));
const all: { name: string; quote: string; featured?: boolean }[] = reviews.reviews ?? [];
const quote = all.find((r) => r.featured) ?? all[0];
---

<BaseLayout title={home.seo?.title} description={home.seo?.description} image={hero.image}>
  <!-- Opening -->
  <section class="bg-mist">
    <div class="wrap grid items-center gap-12 py-12 lg:grid-cols-12 lg:gap-8 lg:py-20">
      <div class="lg:col-span-6">
        <h1 class="text-display max-w-[13ch]">{hero.heading}</h1>
        <p class="mt-6 max-w-lg text-lead">{hero.text}</p>
        <div class="mt-9 flex flex-wrap items-center gap-x-7 gap-y-4">
          {hero.primaryLabel && <a href={hero.primaryUrl || '/contact'} class="btn">{hero.primaryLabel}</a>}
          {hero.secondaryLabel && <a href={hero.secondaryUrl || '/treatments'} class="link">{hero.secondaryLabel}</a>}
        </div>

        <dl class="mt-12 grid max-w-xl gap-x-10 gap-y-6 border-t border-ink/15 pt-7 text-[0.975rem] sm:grid-cols-2">
          <div>
            <dt class="label">Find us</dt>
            <dd class="mt-1.5">
              {site.address?.line1}<br />
              {site.address?.area}, {site.address?.postcode}<br />
              <a href={telHref(site.phone)} class="font-semibold text-ink">{site.phone}</a>
            </dd>
          </div>
          <div>
            <dt class="label">Open</dt>
            <dd class="mt-1.5">
              {hours.map((h) => <span class="block">{h.days}, {h.times}</span>)}
            </dd>
          </div>
        </dl>
      </div>
      <Shaped src={hero.image} alt={hero.imageAlt} class="mx-auto w-full max-w-md lg:col-span-5 lg:col-start-8 lg:max-w-none" priority />
    </div>
  </section>

  <!-- Welcome -->
  <section class="section">
    <div class="wrap">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-12">
        <h2 class="text-title lg:col-span-5">{welcome.heading}</h2>
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="space-y-5">
            {(welcome.paragraphs ?? []).map((p: string) => <p>{p}</p>)}
          </div>
          {welcome.linkLabel && <p class="mt-7"><a href={welcome.linkUrl || '/about'} class="link">{welcome.linkLabel}</a></p>}
        </div>
      </div>
      <Img src={welcome.image} alt={welcome.imageAlt} class="shape-soft mt-12 aspect-[4/3] sm:aspect-[21/9] lg:mt-16" sizes="(min-width: 1280px) 1150px, 92vw" width={1200} position="center 30%" />
    </div>
  </section>

  <!-- Treatments -->
  <section class="pb-[var(--spacing-section)]" aria-label="Treatments">
    <div class="wrap grid gap-6 lg:grid-cols-2">
      <div class="shape-soft bg-mist p-7 sm:p-10 lg:p-12">
        <h2 class="text-title">{dental.heading}</h2>
        <p class="mt-3 max-w-md">{dental.text}</p>
        <div class="mt-9"><TreatmentMenu type="dental" compact /></div>
        <p class="mt-9"><a href="/treatments" class="link">{dental.linkLabel || 'All dental treatments'}</a></p>
      </div>
      <div class="shape-soft bg-shell p-7 sm:p-10 lg:p-12">
        <h2 class="text-title">{aesthetics.heading}</h2>
        <p class="mt-3 max-w-md">{aesthetics.text}</p>
        <div class="mt-9"><TreatmentMenu type="aesthetics" compact /></div>
        <p class="mt-9"><a href="/facial-aesthetics-treatments" class="link">{aesthetics.linkLabel || 'All aesthetic treatments'}</a></p>
      </div>
    </div>
  </section>

  <!-- Patient quote -->
  {quote && (
    <section class="on-teal bg-teal">
      <figure class="wrap grid gap-8 py-16 lg:grid-cols-12 lg:py-24">
        <blockquote class="font-display text-[clamp(1.5rem,1.2rem+1.5vw,2.35rem)] leading-[1.3] text-white lg:col-span-9">
          &ldquo;{quote.quote}&rdquo;
        </blockquote>
        <figcaption class="lg:col-span-9">
          <span class="font-semibold text-white">{quote.name}</span>, patient
          <a href="/reviews" class="link ml-4">More reviews</a>
        </figcaption>
      </figure>
    </section>
  )}

  <!-- How we work -->
  <section class="section">
    <div class="wrap grid items-center gap-12 lg:grid-cols-12">
      <Shaped src={reasons.image} alt={reasons.imageAlt} class="mx-auto w-full max-w-sm lg:col-span-4 lg:max-w-none" sizes="(min-width: 1024px) 30vw, 80vw" width={520} />
      <div class="lg:col-span-7 lg:col-start-6">
        <h2 class="text-title">{reasons.heading}</h2>
        <dl class="mt-9 grid gap-x-12 gap-y-8 sm:grid-cols-2">
          {(reasons.items ?? []).map((r: { title: string; text: string }) => (
            <div>
              <dt class="text-lg font-semibold text-ink">{r.title}</dt>
              <dd class="mt-1.5 text-muted">{r.text}</dd>
            </div>
          ))}
        </dl>

        {offer.show !== false && offer.heading && (
          <div class="shape-soft mt-12 flex flex-wrap items-center justify-between gap-x-10 gap-y-5 border-[1.5px] border-teal/40 p-6 sm:p-8">
            <div class="max-w-sm">
              {offer.eyebrow && <p class="label">{offer.eyebrow}</p>}
              <h3 class="mt-1 text-2xl">{offer.heading}</h3>
              <p class="mt-2 text-muted">{offer.text}</p>
            </div>
            <div class="flex items-center gap-6">
              <p class="font-display text-5xl text-ink">{offer.price}</p>
              {offer.buttonLabel && <a href={offer.buttonUrl || '/contact'} class="btn">{offer.buttonLabel}</a>}
            </div>
          </div>
        )}
      </div>
    </div>
  </section>

  <Booking />
  <Visit />
</BaseLayout>
