<style>
  /* Tab button styles */
  .fee-tab,
  .fee-tab-child,
  .fee-tab-aesthetics {
    @apply bg-white text-text-secondary border border-border-light cursor-pointer;
  }

  .fee-tab.active,
  .fee-tab-child.active,
  .fee-tab-aesthetics.active {
    @apply bg-primary text-white border-primary shadow-soft;
  }

  .fee-tab:not(.active):hover,
  .fee-tab-child:not(.active):hover,
  .fee-tab-aesthetics:not(.active):hover {
    @apply bg-bg-alt text-primary border-primary;
  }
</style>

<script>
  // Generic tab switching function
  function initTabs(tabSelector: string, panelPrefix: string) {
    const tabs = document.querySelectorAll(tabSelector);

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetTab = (tab as HTMLElement).dataset.tab;
        if (!targetTab) return;

        // Deactivate all tabs in this group
        tabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });

        // Hide all panels in this group
        document.querySelectorAll(`.${panelPrefix}`).forEach((panel) => {
          panel.classList.add('hidden');
        });

        // Activate clicked tab
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        // Show target panel
        const targetPanel = document.getElementById(`panel-${targetTab}`);
        if (targetPanel) {
          targetPanel.classList.remove('hidden');
        }
      });
    });
  }

  // Initialize all three tab groups
  initTabs('.fee-tab', 'fee-panel');
  initTabs('.fee-tab-child', 'fee-panel-child');
  initTabs('.fee-tab-aesthetics', 'fee-panel-aesthetics');
</script>
