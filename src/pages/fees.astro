---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import OfferCard from '../components/OfferCard.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
---

<BaseLayout title="Fees, Payment & Membership Plans - ProDenta" description="Transparent dental pricing with flexible payment options. View our treatment fees, membership plans and special offers at ProDenta Battersea.">

  <HeroSection
    title="Fees, Payment and Membership Plans"
    subtitle="Transparent pricing with flexible payment options to suit your needs. Quality dental care that's accessible to everyone."
    image="/images/fees-hero.jpg"
    imageAlt="Fees and Payment Plans"
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'Fees, Payment and Membership Plans' },
    ]}
  />

  <main>
    <!-- Limited Time Offers -->
    <section class="section-padding bg-bg-alt">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-section font-display font-bold uppercase tracking-wider text-primary text-center mb-4">Limited Time Offers</h2>
        <p class="text-text-secondary text-center mb-12 max-w-2xl mx-auto">Take advantage of our special offers and start your journey to a healthier, more confident smile.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <OfferCard
            title="New Patient Special"
            price="£195"
            description="Full examination & hygiene clean"
          />
          <OfferCard
            title="Over 40s Special"
            price="Limited Time"
            description="Take control of your smile with our special package"
          />
          <OfferCard
            title="£65 OTC Teeth Whitening"
            price="£65"
            description="Professional at-home whitening kit"
          />
        </div>
      </div>
    </section>

    <!-- Cost of Your Treatment -->
    <section class="section-padding">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <div>
          <img src="/images/payment-plans.jpg" alt="Payment Plans" class="rounded-2xl shadow-soft w-full object-cover aspect-[4/3]" loading="lazy">
        </div>
        <div>
          <h2 class="text-section font-display font-bold uppercase tracking-wider text-primary mb-6">Cost of Your Treatment</h2>
          <h3 class="text-xl font-display font-bold uppercase tracking-wider text-primary mb-4">Pay As You Go</h3>
          <p class="text-text-primary leading-relaxed mb-6">We offer transparent pricing for all of our treatments. You can pay for your treatment in full at the time of your appointment. We accept all major credit and debit cards.</p>
          <h3 class="text-xl font-display font-bold uppercase tracking-wider text-primary mb-4">Spread the Cost</h3>
          <p class="text-text-primary leading-relaxed mb-8">For more extensive treatments, we offer flexible payment plans so you can spread the cost over a period that suits you. Ask our team for details on interest-free and low-cost finance options.</p>
          <a href="/contact" class="cta-button">Request a Quote</a>
        </div>
      </div>
    </section>

    <!-- Adult Membership Plans -->
    <section class="section-padding bg-bg-blue">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-section font-display font-bold uppercase tracking-wider text-primary text-center mb-4">Adult Membership Plans</h2>
        <p class="text-text-secondary text-center mb-12 max-w-2xl mx-auto">Join our membership plans and enjoy discounted treatment fees, routine care and worldwide emergency cover.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- ProDenta Plus (Featured) -->
          <div class="bg-white rounded-xl shadow-hover p-8 border-2 border-primary relative">
            <div class="absolute -top-4 left-1/2 -translate-x-1/2">
              <span class="bg-primary text-white font-display font-semibold uppercase tracking-wider text-xs px-4 py-1.5 rounded-full">Most Popular</span>
            </div>
            <h3 class="font-display font-bold uppercase tracking-wider text-primary text-center text-lg mb-2 mt-2">ProDenta Plus</h3>
            <div class="text-center mb-6">
              <span class="text-4xl font-display font-bold text-primary">£36.50</span>
              <span class="text-text-secondary">/month</span>
            </div>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">2 dental check-ups per year</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">4 hygiene visits per year</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">All necessary x-rays included</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm font-semibold">15% discount on all treatments</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">Worldwide dental emergency cover</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">Priority booking</span>
              </li>
            </ul>
            <div class="text-center">
              <a href="/contact" class="cta-button w-full block text-center">Join Now</a>
            </div>
          </div>

          <!-- ProDenta Care -->
          <div class="bg-white rounded-xl shadow-soft p-8 border border-border-light">
            <h3 class="font-display font-bold uppercase tracking-wider text-primary text-center text-lg mb-2">ProDenta Care</h3>
            <div class="text-center mb-6">
              <span class="text-4xl font-display font-bold text-primary">£28.50</span>
              <span class="text-text-secondary">/month</span>
            </div>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">2 dental check-ups per year</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">2 hygiene visits per year</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">All necessary x-rays included</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">10% discount on all treatments</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">Worldwide dental emergency cover</span>
              </li>
            </ul>
            <div class="text-center">
              <a href="/contact" class="cta-button cta-outline w-full block text-center">Join Now</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Children's Membership Plans -->
    <section class="section-padding">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-section font-display font-bold uppercase tracking-wider text-primary text-center mb-4">Children's Membership Plans</h2>
        <p class="text-text-secondary text-center mb-12 max-w-2xl mx-auto">Affordable plans to keep your children's teeth healthy from their very first visit.</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- ProDenta Teen -->
          <div class="bg-white rounded-xl shadow-soft p-8 border border-border-light">
            <h3 class="font-display font-bold uppercase tracking-wider text-primary text-center text-lg mb-1">ProDenta Teen</h3>
            <p class="text-text-secondary text-center text-sm mb-4">Ages 7 - 17</p>
            <div class="text-center mb-6">
              <span class="text-4xl font-display font-bold text-primary">£15.50</span>
              <span class="text-text-secondary">/month</span>
            </div>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">2 dental check-ups per year</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">2 hygiene visits per year</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">All necessary x-rays included</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">10% discount on all treatments</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">Worldwide dental emergency cover</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">Oral health education</span>
              </li>
            </ul>
            <div class="text-center">
              <a href="/contact" class="cta-button cta-outline w-full block text-center">Join Now</a>
            </div>
          </div>

          <!-- ProDenta Junior -->
          <div class="bg-white rounded-xl shadow-soft p-8 border border-border-light">
            <h3 class="font-display font-bold uppercase tracking-wider text-primary text-center text-lg mb-1">ProDenta Junior</h3>
            <p class="text-text-secondary text-center text-sm mb-4">Ages 0 - 6</p>
            <div class="text-center mb-6">
              <span class="text-4xl font-display font-bold text-primary">£10.50</span>
              <span class="text-text-secondary">/month</span>
            </div>
            <ul class="space-y-3 mb-8">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">2 dental check-ups per year</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">All necessary x-rays included</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">Fluoride varnish application</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">10% discount on all treatments</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
                <span class="text-text-primary text-sm">Worldwide dental emergency cover</span>
              </li>
            </ul>
            <div class="text-center">
              <a href="/contact" class="cta-button cta-outline w-full block text-center">Join Now</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Adult Treatment Fee Tables -->
    <section class="section-padding bg-bg-alt" id="adult-fees">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-section font-display font-bold uppercase tracking-wider text-primary text-center mb-4">Adult Treatment Costs</h2>
        <p class="text-text-secondary text-center mb-10 max-w-2xl mx-auto">View our full list of treatment fees. Membership plan holders enjoy discounted rates on all treatments.</p>

        <!-- Category Tabs -->
        <div class="flex flex-wrap justify-center gap-2 mb-10" id="adult-tabs" role="tablist">
          <button class="fee-tab active font-display font-semibold uppercase tracking-wider text-sm px-6 py-3 rounded-lg transition-all duration-300" data-tab="maintain" role="tab" aria-selected="true">Maintain</button>
          <button class="fee-tab font-display font-semibold uppercase tracking-wider text-sm px-6 py-3 rounded-lg transition-all duration-300" data-tab="enhance" role="tab" aria-selected="false">Enhance</button>
          <button class="fee-tab font-display font-semibold uppercase tracking-wider text-sm px-6 py-3 rounded-lg transition-all duration-300" data-tab="repair" role="tab" aria-selected="false">Repair</button>
          <button class="fee-tab font-display font-semibold uppercase tracking-wider text-sm px-6 py-3 rounded-lg transition-all duration-300" data-tab="straighten" role="tab" aria-selected="false">Straighten</button>
          <button class="fee-tab font-display font-semibold uppercase tracking-wider text-sm px-6 py-3 rounded-lg transition-all duration-300" data-tab="restore" role="tab" aria-selected="false">Restore</button>
        </div>

        <!-- Maintain Table -->
        <div class="fee-panel" id="panel-maintain">
          <div class="bg-white rounded-xl shadow-soft overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="bg-primary text-white">
                    <th class="text-left font-display font-semibold uppercase tracking-wider text-xs px-6 py-4">Treatment</th>
                    <th class="text-left font-display font-semibold uppercase tracking-wider text-xs px-6 py-4">Price</th>
                    <th class="text-left font-display font-semibold uppercase tracking-wider text-xs px-6 py-4">With Membership</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border-light">
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Adult Check-Up</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">£60</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">Included</td>
                  </tr>
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Hygiene Clean (40 mins)</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">£95 - £135</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">Included</td>
                  </tr>
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Emergency Appointment</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">£95</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">£85.50</td>
                  </tr>
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Digital 3D Scan</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">£65</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">£58.50</td>
                  </tr>
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Small X-Ray</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">£14</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">Included</td>
                  </tr>
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Large X-Ray (OPG)</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">£65</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">Included</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Enhance Table -->
        <div class="fee-panel hidden" id="panel-enhance">
          <div class="bg-white rounded-xl shadow-soft overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="bg-primary text-white">
                    <th class="text-left font-display font-semibold uppercase tracking-wider text-xs px-6 py-4">Treatment</th>
                    <th class="text-left font-display font-semibold uppercase tracking-wider text-xs px-6 py-4">Price</th>
                    <th class="text-left font-display font-semibold uppercase tracking-wider text-xs px-6 py-4">With Membership</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border-light">
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Composite Bonding (per tooth)</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">£120 - £350</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">£102 - £297.50</td>
                  </tr>
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Direct Composite Veneer</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">From £300</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">From £255</td>
                  </tr>
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Porcelain Veneer</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">From £800</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">From £680</td>
                  </tr>
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Home Teeth Whitening</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">£395</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">£335.75</td>
                  </tr>
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">In-Surgery Teeth Whitening</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">£450</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">£382.50</td>
                  </tr>
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Internal Whitening (per tooth)</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">£195</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">£165.75</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Repair Table -->
        <div class="fee-panel hidden" id="panel-repair">
          <div class="bg-white rounded-xl shadow-soft overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full">
                <thead>
                  <tr class="bg-primary text-white">
                    <th class="text-left font-display font-semibold uppercase tracking-wider text-xs px-6 py-4">Treatment</th>
                    <th class="text-left font-display font-semibold uppercase tracking-wider text-xs px-6 py-4">Price</th>
                    <th class="text-left font-display font-semibold uppercase tracking-wider text-xs px-6 py-4">With Membership</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-border-light">
                  <tr class="hover:bg-bg-alt transition-colors">
                    <td class="px-6 py-4 text-sm text-text-primary">Small Composite Filling</td>
                    <td class="px-6 py-4 text-sm text-text-primary font-semibold">£210</td>
                    <td class="px-6 py-4 text-sm text-primary font-semibold">£178.50</td>
                  </tr>
                  <tr class="hover:bg-bg-alt transition-colors">
