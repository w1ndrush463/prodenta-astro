---
import BaseLayout from '../layouts/BaseLayout.astro';
import { page, site as getSite, telHref } from '../lib/content';
const p = await page('contact');
const site = await getSite();
---

<BaseLayout title="Thank you" noindex>
  <section class="section">
    <div class="wrap wrap-narrow text-center">
      <p class="eyebrow mb-6">Request received</p>
      <h1 class="text-display">{p.successHeading || 'Thank you'}</h1>
      <p class="mx-auto mt-7 max-w-xl text-lead">{p.successText}</p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-5">
        <a href="/" class="btn">Back to home</a>
        <a href={telHref(site.phone)} class="link">Call {site.phone}</a>
      </div>
    </div>
  </section>
</BaseLayout>
