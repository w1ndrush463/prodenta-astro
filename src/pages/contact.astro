---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Visit from '../components/Visit.astro';
import { page, site as getSite, telHref, whatsappHref } from '../lib/content';

const p = await page('contact');
const site = await getSite();
const types: string[] = p.enquiryTypes ?? [];
const breadcrumbs = [{ label: 'Home', url: '/' }, { label: 'Contact' }];
---

<BaseLayout title={p.seo?.title} description={p.seo?.description} image={p.image} breadcrumbs={breadcrumbs}>
  <PageHero heading={p.heading} intro={p.intro} image={p.image} imageAlt={p.imageAlt} breadcrumbs={breadcrumbs} />

  <section class="section">
    <div class="wrap grid gap-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="text-title">Talk to us</h2>
        <dl class="mt-7 space-y-5">
          <div>
            <dt class="label">Call</dt>
            <dd><a href={telHref(site.phone)} class="text-xl font-semibold text-ink underline-offset-4 hover:underline">{site.phone}</a></dd>
          </div>
          {site.whatsapp && (
            <div>
              <dt class="label">WhatsApp</dt>
              <dd><a href={whatsappHref(site.whatsapp)} target="_blank" rel="noopener" class="text-xl font-semibold text-ink underline-offset-4 hover:underline">{site.whatsapp}</a></dd>
            </div>
          )}
          <div>
            <dt class="label">Email</dt>
            <dd><a href={`mailto:${site.email}`} class="text-xl font-semibold text-ink underline-offset-4 hover:underline">{site.email}</a></dd>
          </div>
        </dl>
      </div>

      <div class="lg:col-span-7 lg:col-start-6">
        <h2 class="text-title">{p.formHeading}</h2>
        <p class="mt-3 max-w-xl">{p.formText}</p>

        <form name="enquiry" method="POST" action="/thank-you" data-netlify="true" netlify-honeypot="company" class="mt-8 grid gap-x-6 gap-y-6 sm:grid-cols-2">
          <input type="hidden" name="form-name" value="enquiry" />
          <p class="hidden"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
          <div class="field">
            <label for="first-name">First name</label>
            <input id="first-name" name="first-name" type="text" autocomplete="given-name" required />
          </div>
          <div class="field">
            <label for="last-name">Last name</label>
            <input id="last-name" name="last-name" type="text" autocomplete="family-name" required />
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="phone">Phone</label>
            <input id="phone" name="phone" type="tel" autocomplete="tel" required />
          </div>
          <div class="field sm:col-span-2">
            <label for="enquiry-type">How can we help?</label>
            <select id="enquiry-type" name="enquiry-type" required>
              <option value="">Please choose</option>
              {types.map((t) => <option>{t}</option>)}
            </select>
          </div>
          <div class="field sm:col-span-2">
            <label for="preferred-time">Preferred days or times <span class="font-normal text-muted">(optional)</span></label>
            <input id="preferred-time" name="preferred-time" type="text" />
          </div>
          <div class="field sm:col-span-2">
            <label for="message">Message <span class="font-normal text-muted">(optional)</span></label>
            <textarea id="message" name="message" rows="4"></textarea>
          </div>
          <div class="sm:col-span-2">
            <button type="submit" class="btn">Send request</button>
            <p class="mt-5 max-w-xl text-sm text-muted">We use your details only to respond to your enquiry. Please do not include sensitive medical information in this form.</p>
          </div>
        </form>
      </div>
    </div>
  </section>

  <Visit showTravel />
</BaseLayout>
