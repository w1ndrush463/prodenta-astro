---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Portrait from '../../components/Portrait.astro';
import Booking from '../../components/Booking.astro';
import { page } from '../../lib/content';

const p = await page('team');
const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(members.map((m) => m.data.group))].map((name) => ({
  name,
  members: members.filter((m) => m.data.group === name),
}));
const breadcrumbs = [{ label: 'Home', url: '/' }, { label: 'Team' }];
---

<BaseLayout title={p.seo?.title} description={p.seo?.description} image={p.image} breadcrumbs={breadcrumbs}>
  <PageHero heading={p.heading} intro={p.intro} image={p.image} imageAlt={p.imageAlt} breadcrumbs={breadcrumbs} />

  {groups.map((g) => (
    <section class="section-tight border-b border-line last-of-type:border-b-0">
      <div class="wrap">
        <h2 class="text-title">{g.name}</h2>
        <ul class="mt-9 grid grid-cols-2 gap-x-6 gap-y-12 md:grid-cols-3 lg:gap-x-12">
          {g.members.map((m) => (
            <li>
              <a href={`/team/${m.id}`} class="group block">
                <Portrait photo={m.data.photo} name={m.data.name} />
                <h3 class="mt-4 font-sans text-lg font-semibold underline-offset-4 group-hover:underline">{m.data.name}</h3>
                <p class="text-muted">{m.data.role}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <Booking />
</BaseLayout>
