---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Portrait from '../../components/Portrait.astro';
import Booking from '../../components/Booking.astro';

export async function getStaticPaths() {
  const members = await getCollection('team');
  return members.map((member) => ({ params: { slug: member.id }, props: { member } }));
}
const { member } = Astro.props;
const m = member.data;
const { Content } = await render(member);
const breadcrumbs = [{ label: 'Home', url: '/' }, { label: 'Team', url: '/team' }, { label: m.name }];
const description = `${m.name}, ${m.role} at ProDenta, a private dental practice in Battersea, London.`;
---

<BaseLayout title={m.name} description={description} image={m.photo} breadcrumbs={breadcrumbs}>
  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-5">
        <Portrait photo={m.photo} name={m.name} class="aspect-[4/5] lg:sticky lg:top-32" sizes="(min-width: 1024px) 40vw, 100vw" priority />
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <nav aria-label="Breadcrumb" class="mb-8">
          <ol class="flex flex-wrap gap-x-2 text-xs font-medium uppercase tracking-[0.16em] text-muted">
            <li class="flex gap-2"><a href="/" class="hover:text-ink">Home</a><span aria-hidden="true">/</span></li>
            <li class="flex gap-2"><a href="/team" class="hover:text-ink">Team</a><span aria-hidden="true">/</span></li>
            <li><span aria-current="page" class="text-ink">{m.name}</span></li>
          </ol>
        </nav>
        <p class="eyebrow mb-5">{m.role}</p>
        <h1 class="text-display">{m.name}</h1>
        <div class="prose-site mt-10 max-w-xl">
          <Content />
        </div>
        {m.expertise.length > 0 && (
          <div class="mt-12 max-w-xl">
            <h2 class="eyebrow !font-sans">Areas of interest</h2>
            <ul class="mt-4 border-t border-ink/80">
              {m.expertise.map((e) => <li class="border-b border-line py-3 font-display text-[1.4rem] text-ink">{e}</li>)}
            </ul>
          </div>
        )}
        <p class="mt-12"><a href="/team" class="link"><span aria-hidden="true">&larr;</span> All team members</a></p>
      </div>
    </div>
  </section>
  <Booking />
</BaseLayout>
