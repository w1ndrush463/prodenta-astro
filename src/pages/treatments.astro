---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TreatmentMenu from '../components/TreatmentMenu.astro';
import Booking from '../components/Booking.astro';
import { page, groupedTreatments } from '../lib/content';

const p = await page('treatments');
const groups = await groupedTreatments('dental');
const breadcrumbs = [{ label: 'Home', url: '/' }, { label: p.heading }];
---

<BaseLayout title={p.seo?.title} description={p.seo?.description} image={p.image} breadcrumbs={breadcrumbs} tone="default">
  <PageHero heading={p.heading} intro={p.intro} image={p.image} imageAlt={p.imageAlt} breadcrumbs={breadcrumbs} surface="bg-mist" />

  <nav class="sticky top-[4.25rem] z-30 border-b border-line bg-white lg:top-20" aria-label="Treatment categories">
    <ul class="wrap flex gap-7 overflow-x-auto py-3.5 font-medium text-ink">
      {groups.map((g) => <li class="shrink-0"><a href={`#${g.id}`} class="underline-offset-4 hover:underline">{g.title}</a></li>)}
    </ul>
  </nav>

  <section class="section">
    <div class="wrap">
      <TreatmentMenu type="dental" />
    </div>
  </section>

  <Booking />
</BaseLayout>
