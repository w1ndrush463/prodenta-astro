---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TreatmentMenu from '../components/TreatmentMenu.astro';
import Booking from '../components/Booking.astro';
import { page, groupedTreatments } from '../lib/content';

const p = await page('treatments');
const groups = await groupedTreatments('dental');
const breadcrumbs = [{ label: 'Home', url: '/' }, { label: p.heading }];
---

<BaseLayout title={p.seo?.title} description={p.seo?.description} image={p.image} breadcrumbs={breadcrumbs} tone="default">
  <PageHero heading={p.heading} intro={p.intro} image={p.image} imageAlt={p.imageAlt} breadcrumbs={breadcrumbs} surface="bg-sand" />

  <nav class="sticky top-[4.5rem] z-30 border-b border-line bg-ivory/95 backdrop-blur-sm lg:top-[5.25rem]" aria-label="Treatment categories">
    <ul class="wrap flex gap-8 overflow-x-auto py-4 text-xs font-semibold uppercase tracking-[0.16em] text-ink">
      {groups.map((g) => <li class="shrink-0"><a href={`#${g.id}`} class="hover:text-clay">{g.title}</a></li>)}
    </ul>
  </nav>

  <section class="section">
    <div class="wrap">
      <TreatmentMenu type="dental" />
    </div>
  </section>

  <Booking />
</BaseLayout>
