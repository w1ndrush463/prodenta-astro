---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Booking from '../components/Booking.astro';
import Visit from '../components/Visit.astro';
import { page } from '../lib/content';

const p = await page('about');
const breadcrumbs = [{ label: 'Home', url: '/' }, { label: 'About' }];
const values: { title: string; text: string }[] = p.values ?? [];
---

<BaseLayout title={p.seo?.title} description={p.seo?.description} image={p.image} breadcrumbs={breadcrumbs}>
  <PageHero eyebrow="About the practice" heading={p.heading} intro={p.intro} image={p.image} imageAlt={p.imageAlt} breadcrumbs={breadcrumbs} />

  <section class="section">
    <div class="wrap grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
      <Img src={p.storyImage} alt={p.storyImageAlt} class="aspect-[4/5] lg:col-span-5" sizes="(min-width: 1024px) 40vw, 100vw" width={700} />
      <div class="lg:col-span-6 lg:col-start-7" data-reveal>
        <p class="eyebrow mb-5">Our philosophy</p>
        <h2 class="text-title max-w-[15ch]">{p.storyHeading}</h2>
        <div class="mt-8 space-y-5">
          {(p.story ?? []).map((s: string, i: number) => <p class:list={[i === 0 && 'text-lead text-ink']}>{s}</p>)}
        </div>
        <p class="mt-10"><a href="/team" class="link">Meet the team <span aria-hidden="true">&rarr;</span></a></p>
      </div>
    </div>
  </section>

  {values.length > 0 && (
    <section class="section bg-sand">
      <div class="wrap">
        <h2 class="text-title" data-reveal>{p.valuesHeading}</h2>
        <dl class="mt-12 grid border-t border-ink/80 sm:grid-cols-2 lg:grid-cols-4">
          {values.map((v, i) => (
            <div class:list={['border-b border-ink/15 py-8 sm:pr-8 lg:border-b-0', i > 0 && 'lg:border-l lg:border-ink/15 lg:pl-8']}>
              <dt class="font-display text-[1.75rem] leading-tight text-ink">{v.title}</dt>
              <dd class="mt-3 text-muted">{v.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <Booking />
  <Visit />
</BaseLayout>
