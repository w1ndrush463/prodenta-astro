---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import Booking from '../components/Booking.astro';
import Visit from '../components/Visit.astro';
import { page } from '../lib/content';

const p = await page('about');
const breadcrumbs = [{ label: 'Home', url: '/' }, { label: 'About' }];
const values: { title: string; text: string }[] = p.values ?? [];
---

<BaseLayout title={p.seo?.title} description={p.seo?.description} image={p.image} breadcrumbs={breadcrumbs}>
  <PageHero heading={p.heading} intro={p.intro} image={p.image} imageAlt={p.imageAlt} breadcrumbs={breadcrumbs} />

  <section class="section">
    <div class="wrap grid items-center gap-12 lg:grid-cols-12">
      <Img src={p.storyImage} alt={p.storyImageAlt} class="shape-soft aspect-[4/5] lg:col-span-5" sizes="(min-width: 1024px) 40vw, 100vw" width={700} />
      <div class="lg:col-span-6 lg:col-start-7">
        <h2 class="text-title">{p.storyHeading}</h2>
        <div class="mt-8 space-y-5">
          {(p.story ?? []).map((s: string) => <p>{s}</p>)}
        </div>
        <p class="mt-10"><a href="/team" class="link">Meet the team</a></p>
      </div>
    </div>
  </section>

  {values.length > 0 && (
    <section class="section bg-mist">
      <div class="wrap">
        <h2 class="text-title">{p.valuesHeading}</h2>
        <dl class="mt-9 grid gap-x-12 gap-y-8 sm:grid-cols-2">
          {values.map((v) => (
            <div>
              <dt class="text-lg font-semibold text-ink">{v.title}</dt>
              <dd class="mt-1.5 max-w-md">{v.text}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <Booking />
  <Visit />
</BaseLayout>
