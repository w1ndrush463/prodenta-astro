---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import ConsultationCTA from '../components/ConsultationCTA.astro';
---

<BaseLayout title="About ProDenta - Private Dentist Battersea" description="Learn about ProDenta, your family-friendly dental practice in Battersea. Patient-centered care with a focus on prevention.">

  <HeroSection
    title="About ProDenta"
    subtitle="Your family-friendly dental practice in Battersea"
    image="/images/practice-interior.jpg"
    imageAlt="ProDenta Practice"
    breadcrumbs={[
      { label: 'Home', href: '/' },
      { label: 'About' },
    ]}
  />

  <main>
    <!-- Philosophy Section -->
    <section class="section-padding">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-section font-display font-bold uppercase tracking-wider text-primary mb-6">Our Philosophy</h2>
        <p class="text-lg text-text-primary leading-relaxed mb-8">Our Philosophy is simply to keep dentistry as friendly and stress free as possible. We have a patient centred approach, which means the focus of your care is to keep you as comfortable as possible and achieve the best possible results.</p>

        <h3 class="text-xl font-display font-bold uppercase tracking-wider text-primary mb-4">Prevention is Better Than Cure</h3>
        <p class="text-text-primary leading-relaxed mb-4">We believe strongly in the old adage that 'prevention is better than cure'. The emphasis on oral hygiene and the right tooth-brushing technique cannot be overstated. We take a long-term approach to your dental care.</p>
        <p class="text-text-primary leading-relaxed mb-4">We provide comprehensive treatment and specialist referrals when needed. Our practice welcomes children and offers motivation for maintaining excellent dental health.</p>
        <p class="text-text-primary leading-relaxed mb-8">We use high-quality dental products and focus on patient education and personalized care. Our goal is to help you understand your current dental condition and prevent future issues.</p>
      </div>
    </section>

    <!-- Philosophy Cards -->
    <section class="section-padding bg-bg-alt pt-0">
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl shadow-soft p-8 text-center">
          <div class="w-16 h-16 mx-auto mb-4 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
          </div>
          <h3 class="font-display font-semibold uppercase tracking-wider text-sm text-primary mb-3">Patient-Centered Care</h3>
          <p class="text-text-secondary text-sm">We focus on keeping you comfortable while achieving the best possible results for your oral health.</p>
        </div>
        <div class="bg-white rounded-xl shadow-soft p-8 text-center">
          <div class="w-16 h-16 mx-auto mb-4 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-display font-semibold uppercase tracking-wider text-sm text-primary mb-3">Prevention First</h3>
          <p class="text-text-secondary text-sm">We emphasize oral hygiene and proper tooth-brushing techniques, taking a long-term approach to patient care.</p>
        </div>
        <div class="bg-white rounded-xl shadow-soft p-8 text-center">
          <div class="w-16 h-16 mx-auto mb-4 text-primary">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
            </svg>
          </div>
          <h3 class="font-display font-semibold uppercase tracking-wider text-sm text-primary mb-3">Family-Friendly Environment</h3>
          <p class="text-text-secondary text-sm">We welcome children and adults in our cheerful environment, offering motivation for excellent dental health.</p>
        </div>
      </div>
    </section>

    <!-- Video Section -->
    <section class="section-padding">
      <div class="max-w-4xl mx-auto">
        <video controls class="w-full rounded-2xl shadow-soft" poster="/images/dental.jpg">
          <source src="/videos/A_Dentist_With_His_Patient_optimized.mp4" type="video/mp4">
          Your browser does not support the video tag.
        </video>
      </div>
    </section>

    <!-- Values Section -->
    <section class="section-padding bg-bg-alt">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-section font-display font-bold uppercase tracking-wider text-primary text-center mb-12">What We Believe In</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-xl shadow-soft p-8 text-center">
            <div class="w-16 h-16 mx-auto mb-4 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24" class="w-16 h-16">
                <path d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" />
              </svg>
            </div>
            <h3 class="font-display font-semibold uppercase tracking-wider text-sm text-primary mb-3">Excellence</h3>
            <p class="text-text-secondary text-sm">We use the latest technology and techniques to ensure your comfort and the best possible outcome for your dental health.</p>
          </div>
          <div class="bg-white rounded-xl shadow-soft p-8 text-center">
            <div class="w-16 h-16 mx-auto mb-4 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
              </svg>
            </div>
            <h3 class="font-display font-semibold uppercase tracking-wider text-sm text-primary mb-3">Communication</h3>
            <p class="text-text-secondary text-sm">We believe in open communication, ensuring you are fully informed about your treatment options every step of the way.</p>
          </div>
          <div class="bg-white rounded-xl shadow-soft p-8 text-center">
            <div class="w-16 h-16 mx-auto mb-4 text-primary">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-16 h-16">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
              </svg>
            </div>
            <h3 class="font-display font-semibold uppercase tracking-wider text-sm text-primary mb-3">Trust</h3>
            <p class="text-text-secondary text-sm">We want our patients to have confidence in us to come in for regular maintenance and care.</p>
          </div>
        </div>
      </div>
    </section>

    <ConsultationCTA
      title="Ready to Experience ProDenta Care?"
      description="Contact us today to book your consultation and discover how we can help you achieve optimal oral health in our friendly, stress-free environment."
      buttonText="Book Appointment"
      buttonHref="/contact"
    />
  </main>
</BaseLayout>
