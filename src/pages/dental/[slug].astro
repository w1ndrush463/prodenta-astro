---
import TreatmentPage from '../../components/TreatmentPage.astro';
import { treatmentsOf, slugOf } from '../../lib/content';

export async function getStaticPaths() {
  const items = await treatmentsOf('dental');
  return items.map((treatment) => ({ params: { slug: slugOf(treatment) }, props: { treatment } }));
}
const { treatment } = Astro.props;
---

<TreatmentPage treatment={treatment} />
