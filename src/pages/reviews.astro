---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Booking from '../components/Booking.astro';
import { page } from '../lib/content';

const p = await page('reviews');
const reviews: { name: string; quote: string }[] = (p.reviews ?? []).filter((r: { quote?: string }) => r.quote);
const breadcrumbs = [{ label: 'Home', url: '/' }, { label: 'Reviews' }];
---

<BaseLayout title={p.seo?.title} description={p.seo?.description} image={p.image} breadcrumbs={breadcrumbs}>
  <PageHero heading={p.heading} intro={p.intro} image={p.image} imageAlt={p.imageAlt} breadcrumbs={breadcrumbs} />

  <section class="section">
    <ul class="wrap columns-1 gap-x-6 md:columns-2">
      {reviews.map((r) => (
        <li class="shape-soft mb-6 break-inside-avoid bg-mist p-7 lg:p-9">
          <figure>
            <blockquote class="text-lg text-ink">&ldquo;{r.quote}&rdquo;</blockquote>
            <figcaption class="mt-4 font-semibold text-teal">{r.name}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </section>

  <Booking />
</BaseLayout>
